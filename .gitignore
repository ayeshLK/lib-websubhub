# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Environment files may contain credentials. Keep documented examples trackable.
.env
.env.*
!.env.example
!.env.*.example

# Local agent state, transcripts, indexes, and caches. Repository instructions
# such as AGENTS.md and shareable tool configuration remain trackable.
.agents/
.codex/
.claude/settings.local.json
.aider.chat.history.md
.aider.input.history
.aider.tags.cache*/

# Local logs and scratch directories
*.log
.tmp/

# Editor/IDE
.idea/
.vscode/

# OS metadata
.DS_Store

# Local build output
bin/
dist/

# Repository policy: do not retain binary reference artifacts
*.jar
